{
  "name": "evented-ts",
  "version": "3.0.0-beta.0",
  "description": "Fire and listen to events in JavaScript",
  "main": "./dist/evented.js",
  "types": "./dist/evented.d.ts",
  "exports": {
    ".": {
      "types": "./dist/evented.d.ts",
      "import": "./dist/evented.js"
    }
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:clean": "rimraf dist",
    "build:js": "vite build",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationDir dist --project tsconfig.json",
    "build": "pnpm run build:clean && pnpm run build:js && pnpm run build:types",
    "prepublishOnly": "pnpm run build",
    "release:patch": "pnpm version patch",
    "release:minor": "pnpm version minor",
    "release:major": "pnpm version major",
    "release:beta": "pnpm version prerelease --preid beta",
    "release:beta-major": "pnpm version premajor --preid beta",
    "release:beta-minor": "pnpm version preminor --preid beta",
    "release:beta-patch": "pnpm version prepatch --preid beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maroun-baydoun/evented.git"
  },
  "keywords": [
    "typescript",
    "javascript",
    "events"
  ],
  "author": {
    "name": "Maroun Baydoun",
    "url": "https://maroun-baydoun.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/maroun-baydoun/evented/issues"
  },
  "homepage": "https://dev.maroun-baydoun.com/evented/",
  "devDependencies": {
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
